# Copy this file to .env and fill in real values.
# NEVER commit the real .env file -- it's already in .gitignore.

# MongoDB Atlas connection string. Get this from Atlas -> Connect ->
# Drivers. Replace <username>, <password>, and the cluster host.
MONGODB_URL=mongodb+srv://<username>:<password>@<your-cluster>.mongodb.net/?appName=Cluster0

# Name of the database inside that cluster (this is NOT optional --
# leaving it unset makes every DB call fail with "database not connected").
DATABASE_NAME=fatigue_db

# Generate a real random secret locally with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Do NOT reuse the example below -- generate your own.
SECRET_KEY=replace-with-your-own-generated-secret-key

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=20
REFRESH_TOKEN_EXPIRE_DAYS=30
QR_CODE_EXPIRY_MINUTES=5
FATIGUE_HIGH_THRESHOLD=70
PRODUCTIVITY_LOSS_THRESHOLD=10

# Keep this "false" on any public deployment (Render). It only enables
# local-only diagnostic endpoints that have no authentication.
DEBUG_MODE=false

# Old usage_data/predictions documents are auto-deleted by MongoDB after
# this many days (the dashboard never looks back further than 7 days
# anyway). Safe to leave at the default.
USAGE_DATA_RETENTION_DAYS=10
PREDICTIONS_RETENTION_DAYS=10

# REQUIRED once deployed: the public URL a phone can reach this backend
# at (e.g. https://your-service.onrender.com). Without this, QR pairing
# codes silently embed this machine's local WiFi IP instead, which is
# unreachable from outside your home network -- mobile pairing will
# fail with no obvious error. Leave blank for local dev (falls back to
# LAN-IP auto-detection so a phone on the same WiFi can still test it).
BACKEND_PUBLIC_URL=
